<Project Sdk="Microsoft.NET.Sdk">

  <!-- REUSE, NOT PORT: Telemetry (OTLP wiring) comes from AgentCommon; the
       remote agents are consumed over A2A only — no local model calls, so no
       OllamaSharp reference. -->
  <ItemGroup>
    <ProjectReference Include="..\MafDemo.AgentCommon\MafDemo.AgentCommon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.19.0" />
    <PackageReference Include="Microsoft.Agents.AI.A2A" Version="1.19.0-preview.260822.1" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.19.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Ships appsettings.json next to the binary (same shape as the other
       console projects; the orchestrator itself makes no Ollama calls). -->
  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
