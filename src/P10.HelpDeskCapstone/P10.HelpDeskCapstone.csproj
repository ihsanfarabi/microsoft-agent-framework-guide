<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\MafDemo.Core\MafDemo.Core.csproj" />
    <ProjectReference Include="..\P04.HandbookRag\P04.HandbookRag.csproj" />
    <ProjectReference Include="..\MafDemo.AgentCommon\MafDemo.AgentCommon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Declarative" Version="1.19.0-rc1" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting" Version="1.19.0-preview.260822.1" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.A2A.AspNetCore" Version="1.19.0-preview.260822.1" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.OpenAI" Version="1.19.0-alpha.260822.1" />
    <PackageReference Include="OllamaSharp" Version="5.4.30" />
  </ItemGroup>

  <!-- Declarative agent definitions ship next to the binary so the
       BaseDirectory-based loader works for dotnet run AND the Docker image.
       (Folder is `Definitions/` — `agents/` would case-insensitively collide
       with the C# source folder `Agents/` on macOS.) -->
  <ItemGroup>
    <None Include="Definitions/**/*.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- P04 (project ref) and P10 both carry an appsettings.json; last-wins
         is fine here — both carry the same Ollama keys — and the default
         NETSDK1152 hard error would fail the Docker publish. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

</Project>
