<Project Sdk="Microsoft.NET.Sdk">

  <!-- REUSE, NOT PORT: Core (stores + handbook), AgentCommon (Ollama chat),
       P04 (OllamaEmbedder for the handbook index), P02 (ticket domain pieces). -->
  <ItemGroup>
    <ProjectReference Include="..\MafDemo.AgentCommon\MafDemo.AgentCommon.csproj" />
    <ProjectReference Include="..\MafDemo.Core\MafDemo.Core.csproj" />
    <ProjectReference Include="..\P02.TicketTools\P02.TicketTools.csproj" />
    <ProjectReference Include="..\P04.HandbookRag\P04.HandbookRag.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.19.0" />
    <PackageReference Include="OllamaSharp" Version="5.4.30" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Ships appsettings.json next to the binary so OllamaChat/OllamaEmbedding can read it. -->
  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
