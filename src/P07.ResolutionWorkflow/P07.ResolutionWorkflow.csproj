<Project Sdk="Microsoft.NET.Sdk">

  <!-- REUSE, NOT PORT: Core (stores), AgentCommon (Ollama chat), P06
       (HelpDeskHQ specialists drive the diagnosis node). -->
  <ItemGroup>
    <ProjectReference Include="..\MafDemo.Core\MafDemo.Core.csproj" />
    <ProjectReference Include="..\P06.TriageComposition\P06.TriageComposition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.19.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.19.0" />
    <PackageReference Include="OllamaSharp" Version="5.4.30" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Ships appsettings.json next to the binary so OllamaChat can read it. -->
  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
