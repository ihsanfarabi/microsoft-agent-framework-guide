<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- FactMemoryStore: MEVD InMemory vector store (built against vectordata
         abstractions 10.7.0 — the same pin Microsoft.Agents.AI 1.19.0 uses) plus
         the IEmbeddingGenerator surface the store embeds text with. -->
    <PackageReference Include="CommunityToolkit.VectorData.InMemory" Version="1.0.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
  </ItemGroup>

</Project>

